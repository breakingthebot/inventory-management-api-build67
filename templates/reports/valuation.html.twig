<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Inventory Valuation Certificate</title>
    <style>
        body { font-family: 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; background-color: #0f172a; color: #f8fafc; padding: 20px; }
        .header { border-bottom: 2px solid #3b82f6; padding-bottom: 15px; margin-bottom: 20px; display: flex; justify-content: space-between; align-items: center; }
        .title { font-size: 24px; font-weight: bold; color: #60a5fa; }
        .date { font-size: 14px; color: #94a3b8; }
        table { width: 100%; border-collapse: collapse; margin-top: 15px; }
        th { background-color: #1e293b; color: #38bdf8; padding: 10px; text-align: left; font-size: 13px; border-bottom: 1px solid #334155; }
        td { padding: 10px; border-bottom: 1px solid #334155; font-size: 13px; color: #e2e8f0; }
        tr:nth-child(even) { background-color: #1e293b40; }
        .summary-box { background: #1e293b; border: 1px solid #334155; border-radius: 8px; padding: 15px; margin-bottom: 20px; display: flex; gap: 30px; }
        .metric-label { font-size: 12px; color: #94a3b8; }
        .metric-val { font-size: 20px; font-weight: bold; color: #4ade80; }
    </style>
</head>
<body>
    <div class="header">
        <div>
            <div class="title">INVENTORY VALUATION CERTIFICATE</div>
            <div style="font-size: 12px; color: #cbd5e1;">Official Asset Valuation Statement</div>
        </div>
        <div class="date">Generated: {{ generated_at }}</div>
    </div>

    <div class="summary-box">
        <div>
            <div class="metric-label">Total Catalog SKUs</div>
            <div class="metric-val" style="color: #60a5fa;">{{ total_skus }}</div>
        </div>
        <div>
            <div class="metric-label">Total On-Hand Stock</div>
            <div class="metric-val" style="color: #f59e0b;">{{ total_units }} units</div>
        </div>
        <div>
            <div class="metric-label">Total Portfolio Valuation (USD)</div>
            <div class="metric-val">${{ total_valuation|number_format(2) }}</div>
        </div>
    </div>

    <table>
        <thead>
            <tr>
                <th>ID</th>
                <th>SKU</th>
                <th>Product Name</th>
                <th>Category</th>
                <th>Unit Price</th>
                <th>On-Hand Stock</th>
                <th>Total Valuation</th>
            </tr>
        </thead>
        <tbody>
            {% for item in items %}
            <tr>
                <td>{{ item.id }}</td>
                <td><strong>{{ item.sku }}</strong></td>
                <td>{{ item.name }}</td>
                <td>{{ item.category }}</td>
                <td>${{ item.unit_price|number_format(2) }}</td>
                <td>{{ item.stock_quantity }}</td>
                <td><strong>${{ item.total_value|number_format(2) }}</strong></td>
            </tr>
            {% endfor %}
        </tbody>
    </table>
</body>
</html>
